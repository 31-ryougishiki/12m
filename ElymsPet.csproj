<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <AssemblyName>ElymsPet</AssemblyName>
    <RootNamespace>ElymsPet</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Optimize>true</Optimize>
    <ApplicationManifest>src\app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\pet.ico</ApplicationIcon>
    <AppConfig>src\App.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Security" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="QRCoder"><HintPath>vendor\qrcoder\QRCoder.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Msagl"><HintPath>vendor\msagl\Microsoft.Msagl.dll</HintPath><Private>true</Private></Reference>
    <Content Include="vendor\msagl\LICENSE.txt"><Link>MSAGL-LICENSE.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
    <Compile Include="src\**\*.cs" />
    <EmbeddedResource Include="assets\sprites.png"><LogicalName>sprites.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\pet.ico"><LogicalName>pet.ico</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="assets\persona\elyms.txt"><LogicalName>elyms-persona.txt</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
